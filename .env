DB_HOST=postgres
DB_PORT=5432
DATABASE_URL=postgresql+asyncpg://chatuser:chatpass123@postgres:5432/chatdb

# ============================================
# REDIS CONFIGURATION
# ============================================
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# ============================================
# BACKEND CONFIGURATION
# ============================================
BACKEND_PORT=8000
ENVIRONMENT=development

# JWT/Security
SECRET_KEY=Y_uhyz-LY5WPThDOkuBYqycTa8YAkAP0ctVdimPrw34
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ============================================
# FRONTEND CONFIGURATION
# ============================================
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# ============================================
# OPTIONAL: LOGGING & MONITORING
